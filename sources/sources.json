    {
      "id": "agg-sarkariresult",
      "name": "Sarkari Result",
      "tier": 2,
      "type": "aggregator",
      "url": "https://www.sarkariresult.com/",
      "resolve_official": true,
      "default_category": "job",
      "enabled": true,
      "limit": 40,
      "keywords": ["online form", "recruitment", "admit card", "notification", "vacancy", "answer key", "scholarship"],
      "min_title_len": 25,
      "exclude_keywords": ["android app", "youtube channel", "apple / ios apps", "whatsapp", "telegram channel", "facebook page"],
      "notes": "Discovery-only: detail page se asli official govt link resolve hota hai (lib/official-link.js). Official link na mile to item skip."
    },
    {
